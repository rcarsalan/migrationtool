# ============================================================
# SOURCE: Commercetools (CTP)
# ============================================================
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your_client_id
CTP_CLIENT_SECRET=your_client_secret
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
CTP_SCOPES=manage_project:your-project-key

# ============================================================
# SALESFORCE B2C (SFCC) - OCAPI v22.10
# ============================================================
SFCC_BASE_URL=https://your-instance.demandware.net
SFCC_CLIENT_ID=your_ocapi_client_id
SFCC_CLIENT_SECRET=your_ocapi_client_secret
SFCC_SITE_ID=RefArch
SFCC_VERSION=v22_10

# ============================================================
# MIGRATION SETTINGS
# ============================================================
BATCH_SIZE=50
CONCURRENCY=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000
DRY_RUN=false
LOG_LEVEL=info
